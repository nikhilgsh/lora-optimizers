# Auto-generated SLURM resize artifacts
slurm_job_*_resize.sh
slurm_job_*_resize.csh

# Regenerated notebook renders
notebooks/_render/
notebooks/snapshot_analysis/_data/
notebooks/snapshot_analysis/_renders/

# LaTeX build artifacts (scoped to docs/theory/)
docs/theory/*.aux
docs/theory/*.bbl
docs/theory/*.blg
docs/theory/*.fls
docs/theory/*.fdb_latexmk
docs/theory/*.log
docs/theory/*.out
docs/theory/*.run.xml
docs/theory/*.synctex.gz

#!/usr/bin/env bash
# Regenerate and stage the generated leaderboard when its inputs change.
#
# Enable once per clone (tracked hooks aren't active by default):
#     git config core.hooksPath githooks
#
set -eo pipefail

RELEVANT=0

while IFS= read -r -d '' path; do
  case "$path" in
    docs/notes/leaderboard.md|\
    publication/legacy_leaderboard_v1.json|\
    publication/leaderboard_view.json|\
    scripts/analysis/build_leaderboard_doc.py|\
    scripts/analysis/update_leaderboard.sh|\
    lora_playground/comparison.py|\
    lora_playground/leaderboard.py|\
    lora_playground/leaderboard_variants.py|\
    lora_playground/publication_archive.py|\
    lora_playground/publication_queries.py|\
    lora_playground/publication_semantics.py|\
    lora_playground/publication_views.py|\
    lora_playground/workloads.py|\
    lora_playground/run_records.py)
      RELEVANT=1
      break
      ;;
  esac
done < <(git diff --cached --name-only --diff-filter=ACMRD -z)

if [[ "$RELEVANT" == 0 ]]; then
  exit 0
fi

./scripts/analysis/update_leaderboard.sh --stage

\@writefile{lot}{\contentsline {table}{\numberline {1}{\ignorespaces \textbf  {PoLoRA\xspace  {} speedup over Adam across model families and corpora.} Four base models at rank $r=256$, finetuned on code and math datasets. Step speedup is the steps to reach Adam's final loss. The wall-clock column discounts it by the $\le 3\%$ per-step overhead (\Cref  {app:flops}). PoLoRA\xspace  {} improves on Adam in every setting, by a wider margin on math than on code.}}{8}{table.caption.9}\protected@file@percent }
\newlabel{tab:breadth}{{1}{8}{\textbf {\methodname {} speedup over Adam across model families and corpora.} Four base models at rank $r=256$, finetuned on code and math datasets. Step speedup is the steps to reach Adam's final loss. The wall-clock column discounts it by the $\le 3\%$ per-step overhead (\Cref {app:flops}). \methodname {} improves on Adam in every setting, by a wider margin on math than on code}{table.caption.9}{}}
\newlabel{tab:breadth@cref}{{[table][1][]1}{[1][8][]8}}
\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces \textbf  {Curvature and magnitude both improve PoLoRA\xspace  {}.} Component ablation of Llama-3.2-1B finetuned on math at rank $r = 256$. The left panel shows loss curves as the curvature and then the magnitude control are removed from PoLoRA\xspace  {} in turn, down to Product Muon. The right panel shows the speedup over Adam for each variant.}}{8}{figure.caption.10}\protected@file@percent }
\newlabel{fig:ablation}{{2}{8}{\textbf {Curvature and magnitude both improve \methodname {}.} Component ablation of Llama-3.2-1B finetuned on math at rank $r = 256$. The left panel shows loss curves as the curvature and then the magnitude control are removed from \methodname {} in turn, down to Product Muon. The right panel shows the speedup over Adam for each variant}{figure.caption.10}{}}
\newlabel{fig:ablation@cref}{{[figure][2][]2}{[1][8][]8}}

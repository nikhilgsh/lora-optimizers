# submit-pending tooling artifacts (not part of the project pipeline — the
# authoritative submission record is logs/<group>/run_info/meta.json).
slurm_pending/
slurm_submitted/
slurm_cancel_pending/
slurm_cancel_submitted/
slurm_cancelled/
alloc_pending/
alloc_granted/

# mu-monitor local tool state
.mu_monitor/

# collaborator-shared result artifacts (not project-tracked)
tanya_results/

# bench / smoke scratch (logs, per-run jsonl; not part of the pipeline — the
# authoritative record is logs/<group>/run_info/).
bench_polar_out/
bench_abl_out/
bench_delta_out/
ab_numerics_out/

# arXiv submission build outputs (flattened tree + tarball, regenerated from
# paper/manuscript/; the manuscript sources are what stay tracked).
arxiv_submission/
polora_arxiv.tar.gz

# Claude preview renders (shared with user in-repo; not tracked)
previews/

# Appendix E rewrite standalone build outputs (the .tex stay tracked)
paper/manuscript/appendix_E_rewrites/*_standalone.pdf
paper/manuscript/appendix_E_rewrites/figs/

# disBatch smoke/bench output (575 MB and growing; regenerate by re-running
# the bench, never a build input).
scripts/results/

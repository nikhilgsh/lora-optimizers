#!/usr/bin/env bash
# Remind when leaderboard inputs change; never regenerate or stage data.
#
# Enable once per clone (tracked hooks aren't active by default):
#     git config core.hooksPath githooks
#
# The leaderboard is data-derived publication material. Its documented workflow
# requires a fresh canonical load, review of the concrete diff, and user
# confirmation. A commit hook cannot perform that review and must not mutate the
# index. Keep this check fast and independent of the local logs tree.
set -eo pipefail

STAGED="$(git diff --cached --name-only)"
case "$STAGED" in
  *lora_playground/leaderboard.py*|*lora_playground/workloads.py*|\
  *lora_playground/plotting/labels.py*|*scripts/analysis/build_leaderboard_doc.py*)
    case "$STAGED" in
      *docs/notes/leaderboard.md*) ;;
      *)
        echo "pre-commit: leaderboard inputs changed; regenerate and review docs/notes/leaderboard.md explicitly if this change affects published values" >&2
        ;;
    esac
    ;;
esac
exit 0
